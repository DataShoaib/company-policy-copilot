# Copy this file to .env and fill in real values. Never commit the real .env.

# ---- LLM providers ----
# Groq is the primary model; Gemini is used automatically as the fallback
# (see src/hr_rag/llm.py). No provider switch is needed.
GROQ_API_KEY=your_groq_api_key_here          # https://console.groq.com/keys
GROQ_MODEL=openai/gpt-oss-20b
GOOGLE_API_KEY=your_google_api_key_here      # https://aistudio.google.com/app/apikey
GOOGLE_MODEL=gemini-3.6-flash

# ---- LangSmith tracing (end-to-end: guardrails, retrieval, generation) ----
# Naming styles are interchangeable; the service reads LANGSMITH_API_KEY first,
# then LANGCHAIN_API_KEY. Tracing starts in the API lifespan (api/main.py) and
# the eval notebook, well before the RAG pipeline or LLM router is created --
# that order is load-bearing, because langsmith memoises its env reads.
LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_PROJECT=HR-RAG-Experiments

# ---- MLflow tracking ----
# Local: run `mlflow server --host 0.0.0.0 --port 5000` first, leave default below.
# Remote (e.g. DagsHub): set to your DagsHub MLflow tracking URI.
MLFLOW_TRACKING_URI=http://localhost:5000

# ---- JWT ----
# Generate a real secret with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32

# ---- Database ----
DATABASE_URL=postgresql+psycopg://hr_policy:hr_policy_dev_password@localhost:5432/hr_policy

# ---- Redis ----
# Local dev (docker-compose): redis://redis:6379/0
# Local dev (redis running on host directly): redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ---- CORS ----
# Browser origins allowed to call the API (the Streamlit client runs on 8501).
# Credentials-enabled CORS requires an explicit list, not "*". JSON array.
# CORS_ALLOW_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]
